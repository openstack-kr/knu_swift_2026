      "type": "timeseries",
      "title": "노드별 Sync 처리량 Top 10",
      "description": "노드별 전체 sync 처리량 Top 10입니다. 서버 보정 metric 기준으로 성공 row 처리량을 표시하며, 특정 노드만 높거나 낮으면 부하 쏠림 또는 수집 누락을 의심합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "swift_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, swift_container_sync_recon_row_successes_total{job=\"swift-container-sync-recon\",node=~\"${node:regex}\"})",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "swift_prometheus"
          },
          "interval": "30s",
          "intervalFactor": 1,
          "maxDataPoints": 300
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "spanNulls": true,
            "insertNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
