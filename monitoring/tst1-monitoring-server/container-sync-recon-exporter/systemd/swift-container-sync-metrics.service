[Unit]
Description=Swift Container Sync Prometheus Metrics Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/swift-container-sync-metrics
ExecStart=/usr/bin/python3 /opt/swift-container-sync-metrics/container_sync_metrics.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
