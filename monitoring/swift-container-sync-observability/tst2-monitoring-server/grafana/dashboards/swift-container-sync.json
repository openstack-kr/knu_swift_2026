      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "swift_prometheus"
          },
          "expr": "sum by (node) (swift_container_sync_recon_daemon_new_backlog_rows)",
          "legendFormat": "new rows - {{node}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "swift_prometheus"
          },
          "expr": "sum by (node) (swift_container_sync_recon_daemon_retry_backlog_rows)",
          "legendFormat": "retry rows - {{node}}",
          "range": true,
          "instant": false
