{
  "uid": "swift-container-sync",
  "title": "Swift Container Sync",
  "tags": [
    "swift",
    "container-sync",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 24,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "swift_source_prometheus"
        },
        "label": "Node",
        "query": "label_values(up{job=\"container_sync\",site=\"source\"}, node)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": ".*",
          "selected": true
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": [],
      "datasource": {
        "type": "prometheus",
        "uid": "swift_source_prometheus"
      }
    },
    {
      "id": 1,
      "type": "grafana-polystat-panel",
      "title": "Exporter 상태",
      "description": "source container 노드별 exporter UP/DOWN 상태. 작은 hexagon 상태맵으로 한눈에 확인.",
      "datasource": {
        "type": "prometheus",
        "uid": "swift_source_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"container_sync\",site=\"source\",node=~\"${node:regex}\"}",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "swift_source_prometheus"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "autoSizeColumns": false,
        "autoSizeRows": false,
        "autoSizePolygons": false,
        "layoutDisplayLimit": 50,
        "layoutNumColumns": 4,
        "layoutNumRows": 3,
        "globalShape": "hexagon_pointed_top",
        "globalOperator": "last",
        "globalUnitFormat": "short",
        "globalDecimals": 0,
        "globalShowValueEnabled": false,
        "globalDisplayMode": "all",
        "globalDisplayTextTriggeredEmpty": "OK",
        "globalFillColor": "#73BF69",
        "globalGradientsEnabled": true,
        "globalPolygonBorderColor": "rgba(0, 0, 0, 0)",
        "globalPolygonBorderSize": 1,
        "globalTextFontAutoColorEnabled": false,
        "globalTextFontColor": "#FFFFFF",
        "globalAutoScaleFonts": false,
        "globalLabelFontSize": 8,
        "globalValueFontSize": 9,
        "globalTooltipsEnabled": true,
        "globalTooltipsShowValueEnabled": true,
        "globalTooltipsShowTimestampEnabled": true,
        "globalShowTooltipColumnHeadersEnabled": true,
        "tooltipDisplayMode": "all",
        "tooltipDisplayTextTriggeredEmpty": "OK",
        "sortByField": "name",
        "sortByDirection": 1,
        "globalThresholdsConfig": [
          {
            "value": 0,
            "state": 0,
            "color": "#E02F44"
          },
          {
            "value": 1,
            "state": 1,
            "color": "#73BF69"
          }
        ],
        "overrideConfig": {
          "overrides": []
        },
        "compositeConfig": {
          "enabled": false,
          "animationSpeed": "1500",
          "composites": []
        },
        "globalTextFontFamily": "Inter",
        "globalTooltipsFontFamily": "Inter",
        "globalCompositeValueFontSize": 10,
        "ellipseEnabled": true,
        "ellipseCharacters": 16,
        "globalShowTimestampEnabled": false,
        "globalPolygonSize": "42",
        "radius": 0
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Container Sync 서비스 상태",
      "description": "source container 노드의 exporter endpoint, service 상태를 확인.",
      "datasource": {
        "type": "prometheus",
        "uid": "swift_source_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 17,
        "x": 7,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(up{job=\"container_sync\",site=\"source\",node=~\"${node:regex}\"}, \"os\", \"Ubuntu\", \"node\", \".*\"), \"service\", \"container-sync exporter\", \"node\", \".*\")",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "swift_source_prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Endpoint"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OS"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.width",
                "value": 410
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red"
                      },
                      "1": {
                        "text": "UP",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "enablePagination": false,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Node"
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "role": true,
              "site": true
            },
            "indexByName": {
              "node": 0,
              "instance": 1,
              "os": 2,
              "service": 3,
              "Value": 4
            },
            "renameByName": {
              "node": "Node",
              "instance": "Endpoint",
              "os": "OS",
              "service": "Service",
              "Value": "State"
            }
          }
        }
      ]
    },
